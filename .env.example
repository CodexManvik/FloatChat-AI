# Copy to .env and adjust. Every setting is optional for the Docker setup.

# PostgreSQL (default matches the `db` service in docker-compose.yml, exposed on port 5433)
DATABASE_URL=postgresql+psycopg://floatchat:floatchat@localhost:5433/argo

# LLM: any OpenAI-compatible chat completions endpoint.
# Leave LLM_BASE_URL empty to run without an LLM (data-only answers).
#
# Groq (recommended, free key at https://console.groq.com/keys):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
#
# Other options:
#   Ollama on your machine:        LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:3b
#   Ollama, app running in Docker: LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LM Studio:                     LLM_BASE_URL=http://localhost:1234/v1
#   OpenAI:                        LLM_BASE_URL=https://api.openai.com/v1         (+ LLM_API_KEY)
LLM_TIMEOUT=60

# Vector store
CHROMA_PATH=./chroma_db

# Where the Streamlit frontend finds the API
BACKEND_URL=http://127.0.0.1:8000
